    "method": {
      "type": "string"
    },
    "runtimePath": {
      "type": "string"
    },
    "matchedOpenApiPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetFieldPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposedValue": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string"
    }
  },
  "required": [
    "proposalId",
    "sourceTrafficEventId",
    "sourceFindingId",
    "driftType",
    "changeKind",
    "method",
    "runtimePath",
    "matchedOpenApiPath",
    "targetFieldPath",
    "expected",
    "observed",
    "proposedValue",
    "rationale"
