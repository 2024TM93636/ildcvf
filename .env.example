# ========================
# ILDCVF
# ========================

ILDCVF_ENVIRONMENT=development
ILDCVF_SERVER_PORT=8080


# ========================
# Resident API
# ========================

RESIDENT_API_PORT=8090


# ========================
# LLM - later
# ========================

LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

GROQ_API_KEY=
GROQ_MODEL=


# ========================
# Security - later
# ========================

JWT_SECRET=

# ========================
# Resident API target
# ========================

RESIDENT_API_BASE_URL=http://localhost:8090


# ========================
# PostgreSQL
# ========================

POSTGRES_DB=ildcvf
POSTGRES_USER=ildcvf
POSTGRES_PASSWORD=ildcvf

DB_HOST=localhost
DB_PORT=5432


# ========================
# Runtime evidence capture
# ========================

TRAFFIC_MAX_CAPTURE_BYTES=65536