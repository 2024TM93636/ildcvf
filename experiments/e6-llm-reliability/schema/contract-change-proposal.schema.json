        "ADD_REQUEST_FIELD",
        "RELAX_REQUEST_REQUIRED_FIELD",
        "CHANGE_REQUEST_FIELD_TYPE",
        "ADD_REQUEST_ENUM_VALUE",
        "ADD_RESPONSE_STATUS",
        "ADD_RESPONSE_FIELD",
        "RELAX_RESPONSE_REQUIRED_FIELD",
        "CHANGE_RESPONSE_FIELD_TYPE",
        "ADD_RESPONSE_ENUM_VALUE"
